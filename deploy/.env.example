# Публичный IPv4 VPS (curl -4s ifconfig.me) — для ICE/mediasoup
VPS_PUBLIC_IP=203.0.113.10

# Пароль PostgreSQL
POSTGRES_PASSWORD=замените_на_длинный_случайный

# Секрет JWT (длинная случайная строка)
JWT_SECRET=замените_на_другую_длинную_строку

# URL без хвоста /api — фронт сам добавит /api/v1
# Пример с доменом: https://meet.example.com
# Пример по IP (только http): http://203.0.113.10
PUBLIC_BASE_URL=https://meet.example.com

# WebSocket signaling (путь /ws как в локальном nginx)
PUBLIC_WS_URL=wss://meet.example.com/ws

# CORS в release: суффиксы Origin через запятую (домен без схемы)
# Для одного домена с PUBLIC_BASE_URL достаточно:
ALLOWED_ORIGIN_SUFFIXES=meet.example.com
