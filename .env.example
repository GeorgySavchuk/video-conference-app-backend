# Скопируйте в файл .env в этой же папке (video-conference-app-backend) и подставьте свои значения.
# Файл .env не коммитится (см. .gitignore). После правок перезапустите: go run main.go

# --- PostgreSQL (как в README) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=video_conference

JWT_SECRET=замените_на_случайную_строку

# Порт API (по умолчанию 8080)
# PORT=8080

# --- Почта (приглашения, напоминания, отмена). Без SMTP_HOST и SMTP_FROM письма не отправляются. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ваш_отправитель@gmail.com
SMTP_PASSWORD=пароль_приложения_gmail
SMTP_FROM=HellConf <ваш_отправитель@gmail.com>
